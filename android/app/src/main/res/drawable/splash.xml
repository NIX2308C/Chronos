<?xml version="1.0" encoding="utf-8"?>
<!-- Handed to Chrome while it warms up, so the launch reads as the app rather
     than as a browser opening.

     The bitmap MUST be a real raster, not @mipmap/ic_launcher: on API 26+ that
     name resolves to the <adaptive-icon> in mipmap-anydpi-v26/, and
     BitmapDrawable cannot inflate one. Doing that threw inside
     LauncherActivity.onCreate, so the app died before showing a window. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/backgroundColor" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
