# --- Secrets: never commit these ---
.env
.env.*
!.env.example
firebase_credentials.json
*.pem
*.key
*.p12
serviceAccount*.json

# --- Python ---
venv/
.venv/
__pycache__/
*.pyc
*.pyo

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Agent skills (installed locally, not part of the app) ---
.agents/
skills-lock.json

# --- Local Claude Code project notes / settings (not for the public repo) ---
CLAUDE.md
.claude/

# --- Android (phase C). The project sources are committed; build output,
# Gradle's caches and anything that can sign a release are not. ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
*.keystore
*.jks

# Intermediate files that can carry a signing key in text form. Writing one of
# these into the repo by accident is an easy mistake; this makes it harmless.
*.b64
*.base64
keystore*.txt
