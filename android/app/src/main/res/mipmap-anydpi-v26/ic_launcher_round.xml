<?xml version="1.0" encoding="utf-8"?>
<!-- API 26+. The launcher masks and animates the two layers independently, so
     the foreground is drawn on a transparent canvas with the mark inside the
     middle 72dp of 108dp; the outer ring is croppable. Below API 26 the square
     and round PNGs in mipmap-<density>/ are used instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
