<?xml version="1.0" encoding="utf-8"?>
<!--
  The native app. This replaced a Trusted Web Activity, which had no Activity of
  its own (LauncherActivity came from androidbrowserhelper) and therefore no
  source. Everything the TWA needed — the asset-statement meta-data, the
  DelegationService, the splash FileProvider, the https intent filter — went with
  it. The TWA is preserved on the `twa-legacy` branch.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The TWA never declared this: androidbrowserhelper's manifest merged it
         in. With the library gone it has to be declared here, or every call
         fails with a SecurityException. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ChronosApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chronos">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Chronos.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
